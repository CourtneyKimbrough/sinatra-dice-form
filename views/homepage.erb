<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Dice Roll</title>
</head>
<body>
  <h1>Dice Roll</h1>
  <form action="/process_roll">
  <label for="dicex">Number of dice to roll?</label>
  <input type="text" name="dice" id="dicex">

  <label for="sidesx">How many sides per die?</label>
  <input type="text" name="sides" id="sidesx">

  <button>Roll!</button>
  </form>
</body>
</html>
