<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Dice Roll</title>
  </head>
  <body>
    <h1>
      <%= @num_dice %>d<%= @num_sides%>
    </h1>
    <a href="/process_roll?dice=<%= @num_dice %>&sides=<%= @num_sides %>">Roll again</a>
    <a href="/">Go back home</a>
    <ol>
      <% @rolls.each do |roll| %>
        <li>
          Result: <strong><%= roll %></strong>
        </li>
      <% end %>
    </ol>

  </body>
</html>
